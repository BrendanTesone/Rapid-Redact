# LLM API Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# REQUIRED ENVIRONMENT VARIABLES
# =============================================================================

# LLM API base URL (required)
# This should point to your liteLLM router endpoint or direct API URL
# Examples:
#   - liteLLM router: https://your-litellm-router.com
#   - OpenAI direct: https://api.openai.com/v1
#   - Azure OpenAI: https://your-resource.openai.azure.com
AI_API_BASE_URL=https://your-litellm-router.com

# LLM API key (required)
# This is your API key for authentication
# For liteLLM router: get from your administrator
# For OpenAI: get from platform.openai.com
# DO NOT commit real keys to git
AI_API_KEY=your-api-key-here

# LLM model name (optional, defaults to claude-opus-4.6)
# Examples:
#   - claude-opus-4.6
#   - gpt-4-turbo
#   - anthropic/claude-opus-4.6 (if using liteLLM with provider prefix)
AI_API_MODEL=claude-opus-4.6
